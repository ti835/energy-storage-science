---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@components/shared/TableOfContents.astro';
import { BASE } from '@lib/constants';

export interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  publishDate?: Date;
  category?: 'technology' | 'project' | 'report' | 'paper' | 'safety';
  frontmatter?: Record<string, any>;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  currentPath = '',
  publishDate,
  category,
  headings = [],
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  currentPath={currentPath}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex gap-8">
      <article class="flex-1 min-w-0">
        <!-- Breadcrumb -->
        {
          category && (
            <nav class="flex items-center gap-2 text-sm text-primary-400 mb-6">
              <a href={`${BASE}/`} class="hover:text-primary-600 transition-colors">首页</a>
              <span>/</span>
              <a
                href={`/${category === 'technology' ? 'technologies' : category === 'project' ? 'projects' : category === 'report' ? 'reports' : 'papers'}`}
                class="hover:text-primary-600 transition-colors"
              >
                {category === 'technology' ? '前沿技术' : category === 'project' ? '储能工程' : category === 'report' ? '日报' : '论文'}
              </a>
              <span>/</span>
              <span class="text-primary-600 truncate">{title}</span>
            </nav>
          )
        }

        <!-- Header -->
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-primary-900 leading-tight">{title}</h1>
          {
            publishDate && (
              <time datetime={publishDate.toISOString()} class="text-sm text-primary-400 mt-2 block">
                {publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )
          }
        </header>

        <!-- Content -->
        <div class="prose prose-lg max-w-none">
          <slot />
        </div>
      </article>

      <!-- Sidebar -->
      {
        headings.length > 1 && (
          <aside class="hidden lg:block w-56 flex-shrink-0">
            <div class="sticky top-24">
              <h4 class="text-xs font-semibold text-primary-400 uppercase tracking-wider mb-3">目录</h4>
              <TableOfContents headings={headings} />
              {
                Astro.slots.has('aside') && (
                  <div class="mt-6 pt-6 border-t border-primary-100">
                    <slot name="aside" />
                  </div>
                )
              }
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
