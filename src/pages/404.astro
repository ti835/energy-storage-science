---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { BASE } from '@lib/constants';
---

<DashboardLayout title="页面未找到" description="404 Not Found">
  <div class="text-center py-20">
    <div class="text-7xl font-bold text-primary-200 mb-4">404</div>
    <h1 class="text-2xl font-bold text-primary-900 mb-2">页面未找到</h1>
    <p class="text-primary-500 mb-8">请求的页面不存在或已被移动</p>
    <a href={`${BASE}/`} class="inline-flex px-5 py-2.5 bg-accent-600 text-white rounded-lg font-medium hover:bg-accent-700 transition-colors">
      返回首页
    </a>
  </div>
</DashboardLayout>
