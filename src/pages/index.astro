---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import KpiRow from '@components/dashboard/KpiRow.astro';
import InstallChart from '@components/dashboard/InstallChart.astro';
import PriceSpreadChart from '@components/dashboard/PriceSpreadChart.astro';
import DispatchChart from '@components/dashboard/DispatchChart.astro';
import DailyReportCard from '@components/dashboard/DailyReportCard.astro';
import QuickNavCards from '@components/dashboard/QuickNavCards.astro';
---

<DashboardLayout
  title="数据中枢"
  description="储能科学数据仪表盘 — 每日实时报告、核心指标可视化、技术工程双入口"
>
  <!-- Hero section -->
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-primary-900 mb-2">储能科学</h1>
    <p class="text-lg text-primary-500">数据驱动的储能技术洞察平台 — 每日追踪行业脉搏</p>
  </div>

  <!-- KPI Row -->
  <div class="mb-6">
    <KpiRow
      items={[
        { label: '中国储能装机', value: '249.3', change: 12.5, unit: 'GWh', icon: 'installed' },
        { label: '平均峰谷价差', value: '0.63', change: 3.2, unit: '元/kWh', icon: 'spread' },
        { label: '今日调频次数', value: '59', change: -2.8, unit: '次', icon: 'dispatch' },
        { label: '在建项目', value: '187', change: 8.1, unit: '个', icon: 'projects' },
      ]}
    />
  </div>

  <!-- Dual navigation cards -->
  <div class="mb-6">
    <QuickNavCards />
  </div>

  <!-- Charts grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-bold text-primary-800">新型储能装机增长</h2>
        <span class="text-xs text-primary-400">数据来源: CNESA, IEA</span>
      </div>
      <InstallChart />
    </div>
    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-bold text-primary-800">现货市场峰谷价差（山东）</h2>
        <span class="text-xs text-primary-400">数据来源: 山东电力交易中心</span>
      </div>
      <PriceSpreadChart />
    </div>
  </div>

  <!-- Dispatch chart + Daily report -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="lg:col-span-2">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-bold text-primary-800">电网调度频次（24h分布）</h2>
        <span class="text-xs text-primary-400">山东省调 · {new Date().toLocaleDateString('zh-CN')}</span>
      </div>
      <DispatchChart />
    </div>
    <div>
      <h2 class="text-lg font-bold text-primary-800 mb-3">每日报告</h2>
      <DailyReportCard />
    </div>
  </div>

  <!-- Bottom section: latest content -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl border border-primary-100 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-primary-800">最新技术洞察</h3>
        <a href="/technologies" class="text-xs text-accent-600 hover:text-accent-700">全部 →</a>
      </div>
      <ul class="space-y-3">
        <li>
          <a href="/technologies/solid-state-battery" class="block group">
            <span class="text-sm text-primary-700 group-hover:text-accent-600 transition-colors">固态电池技术深度解析 — 从材料体系到量产挑战</span>
            <span class="text-xs text-primary-400 block mt-0.5">2026-03-15</span>
          </a>
        </li>
        <li>
          <a href="/technologies/sodium-ion-battery" class="block group">
            <span class="text-sm text-primary-700 group-hover:text-accent-600 transition-colors">钠离子电池产业化进程 — 层状氧化物 vs 普鲁士蓝 vs 聚阴离子</span>
            <span class="text-xs text-primary-400 block mt-0.5">2026-04-20</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="bg-white rounded-xl border border-primary-100 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-primary-800">最新工程案例</h3>
        <a href="/projects" class="text-xs text-accent-600 hover:text-accent-700">全部 →</a>
      </div>
      <ul class="space-y-3">
        <li>
          <a href="/projects/shandong-lng-cni-storage" class="block group">
            <span class="text-sm text-primary-700 group-hover:text-accent-600 transition-colors">山东 LNG 接收站 200MW/400MWh 工商业储能项目</span>
            <span class="text-xs text-primary-400 block mt-0.5">烟台 · 施工安装阶段</span>
          </a>
        </li>
        <li>
          <a href="/projects/gansu-gw-compressed-air" class="block group">
            <span class="text-sm text-primary-700 group-hover:text-accent-600 transition-colors">甘肃河西走廊 300MW/1200MWh 压缩空气储能电站</span>
            <span class="text-xs text-primary-400 block mt-0.5">酒泉 · 可行性论证阶段</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</DashboardLayout>
