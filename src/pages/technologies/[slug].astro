---
import { getCollection, type CollectionEntry } from 'astro:content';
import ContentLayout from '@layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const technologies = await getCollection('technologies');
  return technologies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'technologies'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { title, summary, publishDate, tags, category } = entry.data;
---

<ContentLayout
  title={title}
  description={summary}
  currentPath={`/technologies/${entry.slug}`}
  publishDate={publishDate}
  category="technology"
  headings={headings}
>
  <slot name="aside">
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag: string) => (
            <span class="text-xs px-2 py-0.5 bg-primary-100 text-primary-600 rounded-full">{tag}</span>
          ))}
        </div>
      )
    }
  </slot>
  <Content />
</ContentLayout>
