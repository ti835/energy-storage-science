---
import ChartWrapper from '@components/shared/ChartWrapper.astro';
import priceData from '@data/price-spread.json';

const option = {
  tooltip: {
    trigger: 'axis',
    backgroundColor: 'rgba(255,255,255,0.95)',
    borderColor: '#d9e2ec',
    borderWidth: 1,
    textStyle: { color: '#334e68', fontSize: 13 },
    boxShadow: '0 4px 12px rgba(0,0,0,0.08)',
  },
  legend: {
    data: ['峰时电价', '谷时电价', '价差'],
    bottom: 0,
    textStyle: { color: '#627d98', fontSize: 12 },
  },
  grid: { top: 8, right: 16, bottom: 36, left: 16, containLabel: true },
  xAxis: {
    type: 'category',
    data: priceData.dates,
    axisLabel: { color: '#627d98', fontSize: 11 },
    axisTick: { show: false },
  },
  yAxis: {
    type: 'value',
    name: '元/kWh',
    splitLine: { lineStyle: { color: '#f0f4f8', type: 'dashed' } },
    axisLabel: { color: '#627d98', fontSize: 11 },
  },
  series: [
    {
      name: '峰时电价',
      type: 'line',
      data: priceData.shandong.peak,
      smooth: true,
      symbol: 'circle',
      symbolSize: 4,
      lineStyle: { color: '#ef4444', width: 2 },
      itemStyle: { color: '#ef4444' },
      areaStyle: {
        color: {
          type: 'linear',
          x: 0, y: 0, x2: 0, y2: 1,
          colorStops: [
            { offset: 0, color: 'rgba(239,68,68,0.08)' },
            { offset: 1, color: 'rgba(239,68,68,0.0)' },
          ],
        },
      },
    },
    {
      name: '谷时电价',
      type: 'line',
      data: priceData.shandong.valley,
      smooth: true,
      symbol: 'circle',
      symbolSize: 4,
      lineStyle: { color: '#3b82f6', width: 2 },
      itemStyle: { color: '#3b82f6' },
      areaStyle: {
        color: {
          type: 'linear',
          x: 0, y: 0, x2: 0, y2: 1,
          colorStops: [
            { offset: 0, color: 'rgba(59,130,246,0.08)' },
            { offset: 1, color: 'rgba(59,130,246,0.0)' },
          ],
        },
      },
    },
  ],
};
---

<ChartWrapper
  id="price-spread-chart"
  option={option}
  height="380px"
  className="bg-white rounded-xl border border-primary-100 p-5"
/>
