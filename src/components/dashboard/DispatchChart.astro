---
import ChartWrapper from '@components/shared/ChartWrapper.astro';
import dispatchData from '@data/grid-dispatch.json';

const option = {
  tooltip: {
    trigger: 'axis',
    backgroundColor: 'rgba(255,255,255,0.95)',
    borderColor: '#d9e2ec',
    borderWidth: 1,
    textStyle: { color: '#334e68', fontSize: 13 },
    boxShadow: '0 4px 12px rgba(0,0,0,0.08)',
  },
  grid: { top: 8, right: 16, bottom: 36, left: 16, containLabel: true },
  xAxis: {
    type: 'category',
    data: dispatchData.dailyFrequency.labels,
    axisLabel: { color: '#627d98', fontSize: 11 },
    axisTick: { show: false },
    axisLine: { lineStyle: { color: '#d9e2ec' } },
  },
  yAxis: {
    type: 'value',
    name: '次/小时',
    splitLine: { lineStyle: { color: '#f0f4f8', type: 'dashed' } },
    axisLabel: { color: '#627d98', fontSize: 11 },
  },
  series: [
    {
      name: '调频次数',
      type: 'bar',
      data: dispatchData.dailyFrequency.data.map((value: number, index: number) => ({
        value,
        itemStyle: {
          color: value >= 6 ? '#ef4444' : value >= 4 ? '#f59e0b' : '#3b82f6',
          borderRadius: [4, 4, 0, 0],
        },
      })),
      barWidth: '60%',
    },
  ],
};
---

<ChartWrapper
  id="dispatch-chart"
  option={option}
  height="380px"
  className="bg-white rounded-xl border border-primary-100 p-5"
/>
