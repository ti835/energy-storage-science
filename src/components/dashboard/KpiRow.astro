---
import { formatNumber, formatCurrency } from '@lib/format';

export interface KpiItem {
  label: string;
  value: string;
  change: number;
  unit: string;
  icon: 'installed' | 'spread' | 'dispatch' | 'projects';
}

export interface Props {
  items: KpiItem[];
}

const { items } = Astro.props;

const iconPaths: Record<string, string> = {
  installed: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  spread: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  dispatch: 'M13 10V3L4 14h7v7l9-11h-7z',
  projects: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
};

const colors: Record<string, string> = {
  installed: 'from-accent-500 to-accent-600',
  spread: 'from-blue-500 to-blue-600',
  dispatch: 'from-amber-500 to-amber-600',
  projects: 'from-emerald-500 to-emerald-600',
};
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
  {items.map((item) => (
    <div class="bg-white rounded-xl border border-primary-100 p-5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-medium text-primary-400 uppercase tracking-wider">{item.label}</span>
        <div class={`w-9 h-9 bg-gradient-to-br ${colors[item.icon] || 'from-primary-400 to-primary-500'} rounded-lg flex items-center justify-center shadow-sm`}>
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[item.icon] || iconPaths.installed} />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-1.5 mb-1">
        <span class="text-2xl font-bold text-primary-900">{item.value}</span>
        <span class="text-sm text-primary-400">{item.unit}</span>
      </div>
      <div class="flex items-center gap-1">
        <span class={`text-xs font-medium ${item.change >= 0 ? 'text-energy-green' : 'text-energy-red'}`}>
          {item.change >= 0 ? '↑' : '↓'} {Math.abs(item.change)}%
        </span>
        <span class="text-xs text-primary-400">较上月</span>
      </div>
    </div>
  ))}
</div>
