---
import { BASE } from '@lib/constants';
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <a href={`${BASE}/technologies`} class="group relative overflow-hidden bg-white rounded-xl border border-primary-100 hover:border-accent-300 hover:shadow-lg transition-all p-6">
    <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-accent-50 to-transparent rounded-bl-3xl -mr-8 -mt-8 group-hover:scale-150 transition-transform duration-500"></div>
    <div class="relative">
      <div class="w-12 h-12 bg-gradient-to-br from-accent-500 to-accent-700 rounded-xl flex items-center justify-center mb-4 shadow-sm group-hover:shadow-md transition-shadow">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-primary-900 mb-1 group-hover:text-accent-600 transition-colors">前沿储能技术</h3>
      <p class="text-sm text-primary-500 mb-3">
        固态电池 · 液流电池 · 钠离子电池<br/>
        技术参数对比 · 顶刊论文追踪
      </p>
      <span class="text-sm font-medium text-accent-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
        进入专题
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>
  </a>

  <a href={`${BASE}/projects`} class="group relative overflow-hidden bg-white rounded-xl border border-primary-100 hover:border-accent-300 hover:shadow-lg transition-all p-6">
    <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-blue-50 to-transparent rounded-bl-3xl -mr-8 -mt-8 group-hover:scale-150 transition-transform duration-500"></div>
    <div class="relative">
      <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl flex items-center justify-center mb-4 shadow-sm group-hover:shadow-md transition-shadow">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-primary-900 mb-1 group-hover:text-accent-600 transition-colors">最新储能工程</h3>
      <p class="text-sm text-primary-500 mb-3">
        全生命周期案例 · 收益计算工具<br/>
        电网侧 · 工商业 · 光储充一体化
      </p>
      <span class="text-sm font-medium text-accent-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
        进入专题
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>
  </a>
</div>
