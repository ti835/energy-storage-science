---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
---

<nav class="text-sm leading-relaxed">
  <ul class="space-y-1.5">
    {headings.filter(h => h.depth <= 3).map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class={`block text-primary-500 hover:text-primary-700 transition-colors truncate ${
            heading.depth === 2 ? '' : 'pl-3 text-primary-400'
          }`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Active heading tracking
  const headings = document.querySelectorAll('h2[id], h3[id]');
  const links = document.querySelectorAll('nav a[href^="#"]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          links.forEach((link) => {
            link.classList.remove('text-accent-600', 'font-medium');
            link.classList.add('text-primary-500');
            if (link.getAttribute('href') === `#${entry.target.id}`) {
              link.classList.add('text-accent-600', 'font-medium');
              link.classList.remove('text-primary-500');
            }
          });
        }
      });
    },
    { rootMargin: '-80px 0px -80% 0px' }
  );

  headings.forEach((h) => observer.observe(h));
</script>
