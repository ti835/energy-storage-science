---
import comparisonData from '@data/tech-comparison.json';

const { technologies } = comparisonData;
---

<div class="bg-white rounded-xl border border-primary-100 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm" id="spec-table">
      <thead>
        <tr class="bg-primary-800 text-white">
          <th class="px-4 py-3 text-left font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="name">技术路线</th>
          <th class="px-4 py-3 text-right font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="energyDensity">能量密度 (Wh/kg)</th>
          <th class="px-4 py-3 text-right font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="cycleLife">循环寿命 (次)</th>
          <th class="px-4 py-3 text-right font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="lcoe">度电成本 (元/kWh)</th>
          <th class="px-4 py-3 text-right font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="roundTripEfficiency">往返效率</th>
          <th class="px-4 py-3 text-right font-medium cursor-pointer hover:bg-primary-700 transition-colors" data-sort="safetyIndex">安全指数</th>
          <th class="px-4 py-3 text-center font-medium">TRL</th>
        </tr>
      </thead>
      <tbody>
        {technologies.map((tech, idx) => (
          <tr class={`border-t border-primary-100 hover:bg-primary-50 transition-colors ${idx % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}`}>
            <td class="px-4 py-3 font-medium text-primary-800">{tech.name}</td>
            <td class="px-4 py-3 text-right text-primary-700">{tech.energyDensity}</td>
            <td class="px-4 py-3 text-right text-primary-700">{tech.cycleLife.toLocaleString()}</td>
            <td class="px-4 py-3 text-right text-primary-700">{tech.lcoe.toFixed(2)}</td>
            <td class="px-4 py-3 text-right text-primary-700">{tech.roundTripEfficiency}%</td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <div class="w-20 h-1.5 bg-primary-100 rounded-full overflow-hidden">
                  <div
                    class="h-full rounded-full transition-all"
                    class:bg-energy-green={tech.safetyIndex >= 90}
                    class:bg-energy-amber={tech.safetyIndex >= 70 && tech.safetyIndex < 90}
                    class:bg-energy-red={tech.safetyIndex < 70}
                    style={`width: ${tech.safetyIndex}%`}
                  ></div>
                </div>
                <span class="text-primary-700 w-8 text-right">{tech.safetyIndex}</span>
              </div>
            </td>
            <td class="px-4 py-3 text-center">
              <span class={`inline-flex text-xs font-medium px-2 py-0.5 rounded-full ${
                tech.trlLevel >= 9 ? 'bg-energy-green/10 text-energy-green' :
                tech.trlLevel >= 7 ? 'bg-energy-amber/10 text-energy-amber' :
                'bg-primary-100 text-primary-600'
              }`}>
                {tech.trlLevel}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
