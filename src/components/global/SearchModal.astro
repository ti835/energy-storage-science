<!--
  Search modal overlay - uses Pagefind browser API.
  Pagefind bundle is loaded from /pagefind/pagefind.js after build.
  For dev mode, we show a simple notice.
-->

<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="搜索">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-primary-900/60 backdrop-blur-sm" id="search-backdrop"></div>

  <!-- Panel -->
  <div class="relative z-10 max-w-2xl mx-auto mt-[15vh] px-4">
    <div class="bg-white rounded-xl shadow-2xl border border-primary-100 overflow-hidden animate-fade-in">
      <!-- Search input -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-primary-100">
        <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="搜索 固态电池、液流电池、钙钛矿、峰谷套利..."
          class="flex-1 border-0 outline-none text-primary-800 placeholder-primary-300 text-base py-1 bg-transparent"
          autocomplete="off"
        />
        <button id="search-close" class="text-primary-400 hover:text-primary-600 p-1" aria-label="关闭搜索">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Results -->
      <div id="search-results" class="max-h-96 overflow-y-auto p-4">
        <div id="search-loading" class="hidden text-center py-8 text-primary-400 text-sm">
          <div class="animate-pulse-slow">搜索中...</div>
        </div>
        <div id="search-empty" class="text-center py-8 text-primary-400 text-sm">
          输入关键词开始搜索
        </div>
        <div id="search-no-results" class="hidden text-center py-8 text-primary-400 text-sm">
          未找到相关结果，请尝试其他关键词
        </div>
        <div id="search-results-list" class="space-y-3"></div>
      </div>

      <!-- Footer -->
      <div class="px-4 py-2 border-t border-primary-100 bg-gray-50 flex items-center justify-between text-xs text-primary-400">
        <span>Pagefind 全文检索</span>
        <span><kbd class="px-1.5 py-0.5 bg-white border border-primary-200 rounded text-primary-500">ESC</kbd> 关闭</span>
      </div>
    </div>
  </div>
</div>
