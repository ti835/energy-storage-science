---
import { SITE } from '@lib/constants';
import { BASE } from '@lib/constants';
---

<footer class="bg-primary-900 text-primary-300 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 bg-gradient-to-br from-accent-500 to-accent-700 rounded flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-white font-semibold">{SITE.title}</span>
        </div>
        <p class="text-sm leading-relaxed">{SITE.description}</p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">快速导航</h3>
        <ul class="space-y-2">
          <li><a href={`${BASE}/technologies`} class="text-sm hover:text-white transition-colors">前沿储能技术</a></li>
          <li><a href={`${BASE}/projects`} class="text-sm hover:text-white transition-colors">最新储能工程</a></li>
          <li><a href={`${BASE}/papers`} class="text-sm hover:text-white transition-colors">论文追踪</a></li>
          <li><a href={`${BASE}/reports`} class="text-sm hover:text-white transition-colors">日报存档</a></li>
        </ul>
      </div>

      <!-- Tech stack -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">技术驱动</h3>
        <p class="text-sm leading-relaxed">
          基于 Astro + ECharts 构建，Python 自动化数据抓取与 LLM 日报生成，Pagefind 全文检索。
        </p>
      </div>
    </div>

    <div class="border-t border-primary-700 mt-8 pt-6 text-center text-xs text-primary-500">
      &copy; {new Date().getFullYear()} {SITE.title} &mdash; 仅供个人学习与研究使用
    </div>
  </div>
</footer>
